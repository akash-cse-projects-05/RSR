<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HRMS | Enterprise Workforce Management</title>

  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

  <style>
    :root {
      --hrms-blue-dark: #050c1e;
      --hrms-blue-glow: #020612;
      --hrms-electric: #38bdf8;
      --hrms-cyan: #06b6d4;
      --hrms-cobalt: #2563eb;
      --hrms-text-dark: #0f172a;
      --hrms-text-muted: #475569;
      --hrms-border: rgba(15, 23, 42, 0.06);
      --hrms-bg-light: #f8fafc;

      --btn-gradient: linear-gradient(135deg, #2563eb 0%, #0284c7 50%, #06b6d4 100%);
      --btn-gradient-hover: linear-gradient(135deg, #1d4ed8 0%, #0369a1 50%, #0891b2 100%);
    }

    body {
      background-color: #ffffff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--hrms-text-dark);
      letter-spacing: -0.02em;
      scroll-behavior: smooth;
    }

    /* --- LOGO BRANDING EMBLEM --- */
    .navbar {
      background: rgba(255, 255, 255, 0.8) !important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--hrms-border);
      padding: 0.5rem 0;
    }

    .brand-emblem {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, var(--hrms-cobalt) 0%, var(--hrms-cyan) 100%);
      border-radius: 8px;
      color: #ffffff;
      font-size: 0.95rem;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
    }

    .brand-emblem i.fa-circle-nodes {
      font-size: 0.55rem;
      position: absolute;
      bottom: 4px;
      right: 4px;
      color: var(--hrms-electric);
      background: var(--hrms-blue-dark);
      border-radius: 50%;
      padding: 1px;
    }

    .navbar-brand {
      font-weight: 800;
      color: var(--hrms-blue-dark) !important;
      letter-spacing: -0.04em;
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 1.3rem;
    }

    .brand-accent {
      background: linear-gradient(to right, var(--hrms-cobalt), var(--hrms-cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .btn-outline-nav {
      background: transparent;
      color: var(--hrms-cobalt);
      border: 1px solid var(--hrms-cobalt);
      padding: 6px 18px;
      border-radius: 99px;
      font-weight: 700;
      transition: all 0.2s ease;
      font-size: 0.85rem;
      text-decoration: none;
    }

    .btn-outline-nav:hover {
      background: rgba(37, 99, 235, 0.05);
      transform: translateY(-1px);
    }

    .btn-primary-nav {
      background: var(--btn-gradient);
      color: #fff !important;
      border: none;
      padding: 7px 18px;
      border-radius: 99px;
      font-weight: 700;
      transition: all 0.2s ease;
      font-size: 0.85rem;
      text-decoration: none;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
    }

    .btn-primary-nav:hover {
      background: var(--btn-gradient-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(37, 99, 235, 0.25);
    }

    /* --- HERO --- */
    .hero {
      padding: 140px 0 100px;
      background: radial-gradient(circle at 80% 20%, rgba(6, 182, 212, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 20% 80%, rgba(37, 99, 235, 0.12) 0%, transparent 50%),
        linear-gradient(135deg, var(--hrms-blue-dark) 0%, var(--hrms-blue-glow) 100%);
      position: relative;
      overflow: hidden;
    }

    .hero h1 {
      font-weight: 800;
      font-size: 3.8rem;
      line-height: 1.1;
      color: #ffffff;
      margin-bottom: 20px;
      letter-spacing: -0.04em;
    }

    .hero h1 span {
      background: linear-gradient(to right, #ffffff, var(--hrms-electric), var(--hrms-cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: #94a3b8;
      font-size: 1.1rem;
      line-height: 1.6;
      max-width: 520px;
    }

    .hero-tag {
      background: rgba(6, 182, 212, 0.08);
      color: var(--hrms-electric);
      padding: 5px 14px;
      border-radius: 99px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 20px;
      border: 1px solid rgba(6, 182, 212, 0.15);
      letter-spacing: 0.06em;
    }

    .btn-hero-primary {
      background: var(--btn-gradient);
      color: #ffffff !important;
      border: none;
      padding: 12px 32px;
      border-radius: 99px;
      font-weight: 700;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      text-decoration: none;
      display: inline-block;
      box-shadow: 0 10px 25px rgba(37, 99, 235, 0.25);
    }

    .btn-hero-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 30px rgba(6, 182, 212, 0.35);
    }

    .btn-hero-link {
      color: #ffffff;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .btn-hero-link:hover {
      color: var(--hrms-electric);
      transform: translateX(3px);
    }

    /* --- 3-PILLAR ENGINE WIDGET --- */
    .mockup-container {
      perspective: 1400px;
      max-width: 440px;
      margin: 0 auto;
    }

    .mockup-card {
      background: rgba(10, 25, 47, 0.4);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 1.5rem;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
      text-align: left;
      transform: rotateY(-6deg) rotateX(3deg) rotateZ(0.5deg);
      transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mockup-card:hover {
      transform: rotateY(0deg) rotateX(0deg) rotateZ(0deg) translateY(-4px);
      border-color: rgba(6, 182, 212, 0.4);
      box-shadow: 0 30px 60px rgba(6, 182, 212, 0.2);
    }

    .mockup-header {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding-bottom: 0.8rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .mockup-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #ef4444;
    }

    .mockup-dot:nth-child(2) {
      background: #f59e0b;
    }

    .mockup-dot:nth-child(3) {
      background: #10b981;
    }

    .mockup-item {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 10px;
      padding: 0.85rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.8rem;
    }

    .mockup-item:last-child {
      margin-bottom: 0;
    }

    .mockup-item strong {
      color: #f8fafc;
      font-size: 0.88rem;
      font-weight: 600;
    }

    .mockup-item p {
      margin: 0;
      color: #94a3b8;
      font-size: 0.65rem;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.05em;
    }

    .mockup-item span {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.25rem 0.65rem;
      border-radius: 6px;
    }

    .status-badge-cyan {
      color: #22d3ee;
      background: rgba(6, 182, 212, 0.1);
      border: 1px solid rgba(6, 182, 212, 0.15);
    }

    .status-badge-blue {
      color: #38bdf8;
      background: rgba(56, 189, 248, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.15);
    }

    .status-badge-emerald {
      color: #34d399;
      background: rgba(52, 211, 153, 0.1);
      border: 1px solid rgba(52, 211, 153, 0.15);
    }

    /* --- PORTAL ENTRY CARDS GRID --- */
    .section-padding {
      padding: 100px 0;
    }

    .auth-card {
      border: 1px solid var(--hrms-border);
      border-radius: 24px;
      padding: 45px 35px;
      background: #ffffff;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      height: 100%;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.01);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .auth-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 30px 60px rgba(15, 23, 42, 0.08);
      border-color: rgba(37, 99, 235, 0.2);
    }

    .auth-icon-box {
      width: 64px;
      height: 64px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin: 0 auto 24px;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .auth-card:hover .auth-icon-box {
      transform: scale(1.08) rotate(3deg);
    }

    .btn-auth-gradient {
      font-weight: 700;
      border-radius: 12px;
      padding: 12px;
      font-size: 0.9rem;
      background: var(--btn-gradient);
      color: #ffffff;
      border: none;
      transition: all 0.2s ease;
      text-decoration: none;
      display: block;
      text-align: center;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.15);
    }

    .btn-auth-gradient:hover {
      background: var(--btn-gradient-hover);
      color: #ffffff;
      box-shadow: 0 8px 22px rgba(37, 99, 235, 0.3);
      transform: translateY(-1px);
    }

    .btn-auth-outline {
      font-weight: 700;
      border-radius: 12px;
      padding: 11px;
      font-size: 0.9rem;
      background: transparent;
      color: var(--hrms-cobalt);
      border: 1px solid rgba(37, 99, 235, 0.25);
      transition: all 0.2s ease;
      text-decoration: none;
      display: block;
      text-align: center;
    }

    .btn-auth-outline:hover {
      background: rgba(37, 99, 235, 0.04);
      border-color: var(--hrms-cobalt);
    }

    /* --- FEATURES COMPONENT --- */
    .feature-card {
      background: #ffffff;
      border: 1px solid var(--hrms-border);
      border-radius: 20px;
      padding: 2rem 1.75rem;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      height: 100%;
    }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(37, 99, 235, 0.05);
      border-color: var(--hrms-cobalt);
    }

    .feature-icon-wrapper {
      width: 46px;
      height: 46px;
      background: rgba(37, 99, 235, 0.05);
      color: var(--hrms-cobalt);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      margin-bottom: 1.25rem;
    }

    .feature-card:hover .feature-icon-wrapper {
      background: var(--btn-gradient);
      color: #ffffff;
    }

    .img-rounded {
      border-radius: 24px 0 0 24px;
    }

    @media (max-width: 767px) {
      .img-rounded {
        border-radius: 24px 24px 0 0;
      }
    }

    .governance-wrapper {
      background: #ffffff;
      border: 1px solid var(--hrms-border);
      border-radius: 24px;
      box-shadow: 0 30px 60px rgba(15, 23, 42, 0.02);
      overflow: hidden;
    }

    footer {
      background: var(--hrms-bg-light);
      padding: 80px 0 40px;
      border-top: 1px solid var(--hrms-border);
    }
  </style>
</head>

<body>

  <nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
      <a class="navbar-brand" href="/">
        <div class="brand-emblem">
          <i class="fa-solid fa-shield-halved"></i>
          <i class="fa-solid fa-circle-nodes"></i>
        </div>
        <span><span class="brand-accent">H</span>RMS</span>
      </a>
      <div class="ms-auto d-flex gap-2">
        <a href="/auth/register-company" class="btn btn-outline-nav">Register Company</a>
        <a href="#login-gate" class="btn btn-primary-nav">Access Portal</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <div class="container">
      <div class="row align-items-center g-5">

        <div class="col-lg-6">
          <span class="hero-tag">
            <i class="fa-solid fa-bolt-lightning"></i> Next-Gen Workforce Management
          </span>
          <h1>Scale your team <span>with precision.</span></h1>
          <p class="mb-4">
            A centralized Human Resource Management System built for modern enterprises. Streamline attendance, payroll,
            and employee records in one secure platform.
          </p>
          <div class="d-flex gap-4 align-items-center">
            <a href="#login-gate" class="btn-hero-primary">Get Started</a>
            <a href="#features" class="btn-hero-link">Explore Features <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        </div>

        <div class="col-lg-6 text-center">
          <div class="mockup-container">
            <div class="mockup-card">
              <div class="mockup-header">
                <div class="mockup-dot"></div>
                <div class="mockup-dot"></div>
                <div class="mockup-dot"></div>
                <span
                  style="color: #64748b; font-size: 0.7rem; margin-left: 0.4rem; font-family: monospace;">saas-core-engine</span>
              </div>

              <div style="margin-bottom: 1.25rem;">
                <h4
                  style="color: #ffffff; font-size: 0.95rem; margin-bottom: 0.2rem; font-weight: 700; margin-top: 0; letter-spacing: -0.01em;">
                  SaaS Core Modules</h4>
                <p style="color: #64748b; font-size: 0.7rem; margin: 0;">Enterprise infrastructure layer</p>
              </div>

              <div class="mockup-item">
                <div>
                  <p>Directory &amp; Space</p>
                  <strong>Employee Management</strong>
                </div>
                <span class="status-badge-cyan">1,245 ACTIVE</span>
              </div>

              <div class="mockup-item">
                <div>
                  <p>Identity Verification</p>
                  <strong>Attendance Tracking</strong>
                </div>
                <span class="status-badge-blue">LIVE LOGS</span>
              </div>

              <div class="mockup-item">
                <div>
                  <p>Financial Router</p>
                  <strong>Automated Payrolls</strong>
                </div>
                <span class="status-badge-emerald">COMPLIANT</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ENHANCED LOGIN PORTAL GATEWAY CARDS -->
  <section class="section-padding bg-light" id="login-gate">
    <div class="container text-center mb-5 pb-2">
      <h2 class="fw-800 display-5" style="letter-spacing: -0.03em;">Select Your Portal</h2>
      <p class="text-muted" style="font-size: 1.05rem;">Access your workspace or register your organization to get
        started.</p>
    </div>
    <div class="container">
      <div class="row g-4 justify-content-center">

        <!-- Card 1: Employee -->
        <div class="col-lg-4 col-md-6">
          <div class="auth-card text-center">
            <div>
              <div class="auth-icon-box" style="background: rgba(37, 99, 235, 0.05); color: var(--hrms-cobalt);">
                <i class="fa-solid fa-user-tie"></i>
              </div>
              <h4 class="fw-800 mb-3" style="letter-spacing: -0.02em; color: var(--hrms-text-dark);">Employee Space</h4>
              <p class="text-muted small mb-4" style="line-height: 1.65;">Mark attendance seamlessly, check shift
                cycles, download payslips, and manage your workspace profile parameters.</p>
            </div>
            <a href="auth/login" class="btn btn-auth-gradient w-100">Login as Employee</a>
          </div>
        </div>

        <!-- Card 2: Admin -->
        <div class="col-lg-4 col-md-6">
          <div class="auth-card text-center">
            <div>
              <div class="auth-icon-box" style="background: rgba(6, 182, 212, 0.05); color: var(--hrms-cyan);">
                <i class="fa-solid fa-shield-halved"></i>
              </div>
              <h4 class="fw-800 mb-3" style="letter-spacing: -0.02em; color: var(--hrms-text-dark);">HR Administration
              </h4>
              <p class="text-muted small mb-4" style="line-height: 1.65;">Supervise personnel profiles, execute
                automated payroll routes, manage leaves, and verify tracking metrics.</p>
            </div>
            <a href="/hr/hr-login" class="btn btn-auth-gradient w-100">Login as Administrator</a>
          </div>
        </div>

        <!-- Card 3: Register -->
        <div class="col-lg-4 col-md-6">
          <div class="auth-card text-center">
            <div>
              <div class="auth-icon-box" style="background: #f3e8ff; color: #6d28d9;">
                <i class="fa-solid fa-building"></i>
              </div>
              <h4 class="fw-800 mb-3" style="letter-spacing: -0.02em; color: var(--hrms-text-dark);">Register Company
              </h4>
              <p class="text-muted small mb-4" style="line-height: 1.65;">Initialize a brand new secure corporate
                instance workspace, configure admin roles, and scale operations instantly.</p>
            </div>
            <a href="/auth/register-company" class="btn btn-auth-outline w-100">Create New Instance</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2x4 OPERATIONS GRID -->
  <section class="section-padding" id="features">
    <div class="container">
      <div class="row align-items-center mb-5 pb-2">
        <div class="col-md-6">
          <h2 class="fw-800 display-6" style="letter-spacing: -0.03em;">Engineered for Operational Excellence</h2>
        </div>
        <div class="col-md-6 text-md-end">
          <p class="text-muted" style="max-width: 480px; display: inline-block;">A comprehensive suite of tools designed
            to remove administrative friction from your department.</p>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-3 col-md-6">
          <div class="feature-card">
            <div class="feature-icon-wrapper"><i class="fa-solid fa-location-dot"></i></div>
            <h5 class="fw-bold" style="letter-spacing: -0.01em;">GPS Attendance</h5>
            <p class="text-muted small mb-0" style="line-height: 1.6;">Punch in/out from mobile with live location
              tracking.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-card">
            <div class="feature-icon-wrapper"><i class="fa-solid fa-calendar-check"></i></div>
            <h5 class="fw-bold" style="letter-spacing: -0.01em;">Leave Management</h5>
            <p class="text-muted small mb-0" style="line-height: 1.6;">Apply, approve, and track leave balances
              seamlessly.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-card">
            <div class="feature-icon-wrapper"><i class="fa-solid fa-file-invoice-dollar"></i></div>
            <h5 class="fw-bold" style="letter-spacing: -0.01em;">Payroll &amp; Payslips</h5>
            <p class="text-muted small mb-0" style="line-height: 1.6;">Auto-generate salary slips with LOP, PF, and TDS
              calculations.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-card">
            <div class="feature-icon-wrapper"><i class="fa-solid fa-plane-departure"></i></div>
            <h5 class="fw-bold" style="letter-spacing: -0.01em;">Trip Management</h5>
            <p class="text-muted small mb-0" style="line-height: 1.6;">Request and track field employee trips and
              travels.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-card">
            <div class="feature-icon-wrapper"><i class="fa-solid fa-receipt"></i></div>
            <h5 class="fw-bold" style="letter-spacing: -0.01em;">Expense Claims</h5>
            <p class="text-muted small mb-0" style="line-height: 1.6;">Submit and approve expense reimbursements with
              ease.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-card">
            <div class="feature-icon-wrapper"><i class="fa-solid fa-file-shield"></i></div>
            <h5 class="fw-bold" style="letter-spacing: -0.01em;">Document Management</h5>
            <p class="text-muted small mb-0" style="line-height: 1.6;">Upload and verify secure employee documents
              online.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-card">
            <div class="feature-icon-wrapper"><i class="fa-solid fa-list-check"></i></div>
            <h5 class="fw-bold" style="letter-spacing: -0.01em;">Department Tasks</h5>
            <p class="text-muted small mb-0" style="line-height: 1.6;">Assign and track team tasks, goals, and training
              progress.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <div class="feature-card">
            <div class="feature-icon-wrapper"><i class="fa-solid fa-bullhorn"></i></div>
            <h5 class="fw-bold" style="letter-spacing: -0.01em;">Notice Board</h5>
            <p class="text-muted small mb-0" style="line-height: 1.6;">Publish and view global company announcements and
              notifications.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECURITY AUDIT LAYOUT ROW -->
  <section class="container mb-5 pb-5">
    <div class="row g-0 governance-wrapper">
      <div class="col-md-6">
        <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80"
          class="img-fluid h-100 w-100 img-rounded" style="object-fit: cover;" alt="Governance">
      </div>
