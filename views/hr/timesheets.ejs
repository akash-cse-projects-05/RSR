<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Timesheet Billing Dashboard | HRMS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --rsr-blue: #2563eb;
      --rsr-bg: #f8fafc;
      --rsr-light: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: rgba(15, 23, 42, 0.08);
      --hrms-blue-dark: #050c1e;
    }
    body {
      background-color: var(--rsr-bg);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text-main);
    }
    .navbar {
      background: var(--hrms-blue-dark) !important;
      padding: 0.8rem 0;
    }
    .navbar-brand {
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .page-header {
      padding: 40px 0;
      background: #ffffff;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 30px;
    }
    .card {
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.02);
      overflow: hidden;
    }
    .card-header {
      font-weight: 700;
      background: transparent;
      border-bottom: 1px solid var(--border-color);
      padding: 20px 24px;
    }
    .form-control, .form-select {
      border-radius: 10px;
      padding: 10px 14px;
      border: 1px solid var(--border-color);
    }
    .btn-main {
      background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      padding: 10px 20px;
    }
    .btn-main:hover {
      opacity: 0.9;
      color: white;
    }
    .table-container {
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: #ffffff;
      overflow: hidden;
    }
    .table th {
      background: #f8fafc;
      font-weight: 700;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-color);
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
  <div class="container">
    <a class="navbar-brand text-white" href="/hr/dashboard">
      <i class="fa-solid fa-paper-plane me-2"></i> HR Admin Portal
    </a>
    <div class="ms-auto">
      <a href="/hr/dashboard" class="btn btn-outline-light btn-sm rounded-pill px-3">Back to Dashboard</a>
    </div>
  </div>
</nav>

<header class="page-header">
  <div class="container">
    <p class="text-primary fw-bold mb-1" style="letter-spacing: 0.1em; font-size: 0.8rem;">WORKFORCE OPERATIONS</p>
    <h1 class="fw-bold mb-0">Timesheet Logs & Project Billing</h1>
    <p class="text-muted mb-0">Track active projects, audit logged employee hours, and approve timesheets.</p>
  </div>
</header>

<div class="container pb-5">
  <!-- Tabs Navigation -->
  <ul class="nav nav-pills mb-4" id="pills-tab" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active fw-bold px-4 py-2 rounded-pill me-2" id="pills-logs-tab" data-bs-toggle="pill" data-bs-target="#pills-logs" type="button" role="tab">
        <i class="fa-solid fa-business-time me-2"></i> Logged Hours
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link fw-bold px-4 py-2 rounded-pill" id="pills-projects-tab" data-bs-toggle="pill" data-bs-target="#pills-projects" type="button" role="tab">
        <i class="fa-solid fa-diagram-project me-2"></i> Project Management
      </button>
    </li>
  </ul>

  <!-- Tab Contents -->
  <div class="tab-content" id="pills-tabContent">
    
    <!-- Tab 1: Logged Hours -->
    <div class="tab-pane fade show active" id="pills-logs" role="tabpanel">
      <div class="table-container">
        <table class="table mb-0 align-middle">
          <thead>
            <tr>
              <th class="p-3">Employee</th>
              <th class="p-3">Project / Client</th>
              <th class="p-3 text-center">Work Date</th>
              <th class="p-3 text-center">Hours</th>
              <th class="p-3 text-center">Status</th>
              <th class="p-3 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (timesheets && timesheets.length > 0) { %>
              <% timesheets.forEach(ts => { 
                if (ts.employeeId) { %>
                  <tr>
                    <td class="p-3">
                      <div class="fw-bold"><%= ts.employeeId.firstName %> <%= ts.employeeId.lastName %></div>
                      <div class="text-muted small" style="font-size: 11px;"><%= ts.employeeId.employeeCode %> • <%= ts.employeeId.department %></div>
                    </td>
                    <td class="p-3">
                      <div class="fw-bold"><%= ts.projectId ? ts.projectId.name : 'Unknown Project' %></div>
                      <div class="text-secondary small" style="font-size: 11px;"><%= ts.projectId ? ts.projectId.client : '' %> • <%= ts.description %></div>
                    </td>
                    <td class="p-3 text-center text-muted small"><%= new Date(ts.date).toLocaleDateString() %></td>
                    <td class="p-3 text-center fw-bold"><%= ts.hoursWorked %> hrs</td>
                    <td class="p-3 text-center">
                      <span class="badge <%= ts.status === 'Approved' ? 'bg-success bg-opacity-10 text-success' : 'bg-secondary bg-opacity-10 text-secondary' %>">
                        <%= ts.status %>
                      </span>
                    </td>
                    <td class="p-3 text-end">
                      <% if (ts.status === 'Submitted') { %>
                        <form action="/hr/timesheets/approve/<%= ts._id %>" method="POST" style="display:inline;">
                          <button type="submit" class="btn btn-sm btn-main rounded-pill px-3">
                            Approve
                          </button>
                        </form>
                      <% } else { %>
                        <span class="text-success small"><i class="fa-solid fa-circle-check me-1"></i> Approved</span>
                      <% } %>
                    </td>
                  </tr>
                <% } 
              }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="p-5 text-center text-muted">No timesheets logged yet by employees.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tab 2: Project Management -->
    <div class="tab-pane fade" id="pills-projects" role="tabpanel">
      <div class="row g-4">
        <!-- Add Project Form -->
        <div class="col-lg-4">
          <div class="card">
            <div class="card-header">Create Project</div>
            <div class="card-body p-4">
              <form action="/hr/timesheets/project/add" method="POST">
                <div class="mb-3">
                  <label class="form-label fw-600">Project Name</label>
                  <input type="text" name="name" class="form-control" placeholder="e.g. Flight Booking Portal" required />
                </div>
                 <div class="mb-3">
                  <label class="form-label fw-600">Client Name</label>
                  <input type="text" name="client" class="form-control" placeholder="e.g. SpiceJet Airways" required />
                </div>
                 <div class="mb-3">
                  <label class="form-label fw-600">Target Deadline</label>
                  <input type="date" name="deadline" class="form-control" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-600 d-block">Target Departments (Select all that apply)</label>
                  <div class="row g-2">
                    <div class="col-6">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="departments" value="IT" id="dept-it" checked>
                        <label class="form-check-label small" for="dept-it">IT</label>
                      </div>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="departments" value="HR" id="dept-hr">
                        <label class="form-check-label small" for="dept-hr">HR</label>
                      </div>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="departments" value="Finance" id="dept-finance">
                        <label class="form-check-label small" for="dept-finance">Finance</label>
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="departments" value="Sales" id="dept-sales">
                        <label class="form-check-label small" for="dept-sales">Sales</label>
                      </div>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="departments" value="Marketing" id="dept-marketing">
                        <label class="form-check-label small" for="dept-marketing">Marketing</label>
                      </div>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="departments" value="Operations" id="dept-operations">
                        <label class="form-check-label small" for="dept-operations">Operations</label>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="mb-4">
                  <label class="form-label fw-600">Description</label>
                  <textarea name="description" class="form-control" rows="3" placeholder="Brief outline of the project..."></textarea>
                </div>
                <button type="submit" class="btn btn-main w-100 py-3">Create Project</button>
              </form>
            </div>
          </div>
        </div>

        <!-- Projects Overview -->
        <div class="col-lg-8">
          <div class="table-container">
            <table class="table mb-0 align-middle">
              <thead>
                <tr>
                  <th class="p-3">Project Name</th>
                  <th class="p-3">Client</th>
                  <th class="p-3 text-center">Deadline</th>
                  <th class="p-3 text-center">Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (projects && projects.length > 0) { %>
                  <% projects.forEach(p => { %>
                    <tr>
                      <td class="p-3">
                        <div class="fw-bold"><%= p.name %></div>
                        <div class="text-secondary small" style="font-size: 11px;">
                          Depts: <%= p.departments && p.departments.length > 0 ? p.departments.join(', ') : 'All Departments' %>
                        </div>
                      </td>
                      <td class="p-3 text-secondary"><%= p.client %></td>
                      <td class="p-3 text-center text-muted small"><%= p.deadline ? new Date(p.deadline).toLocaleDateString() : 'No Deadline' %></td>
                      <td class="p-3 text-center">
                        <span class="badge <%= p.status === 'Active' ? 'bg-success bg-opacity-10 text-success' : 'bg-secondary bg-opacity-10 text-secondary' %>">
                          <%= p.status %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="p-5 text-center text-muted">No projects defined yet. Create your first client project using the form.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
