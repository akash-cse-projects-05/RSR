<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Appraisal Dashboard | HRMS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --rsr-blue: #2563eb;
      --rsr-bg: #f8fafc;
      --rsr-light: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: rgba(15, 23, 42, 0.08);
      --hrms-blue-dark: #050c1e;
    }
    body {
      background-color: var(--rsr-bg);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text-main);
    }
    .navbar {
      background: var(--hrms-blue-dark) !important;
      padding: 0.8rem 0;
    }
    .navbar-brand {
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .page-header {
      padding: 40px 0;
      background: #ffffff;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 30px;
    }
    .card {
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.02);
    }
    .card-header {
      font-weight: 700;
      background: transparent;
      border-bottom: 1px solid var(--border-color);
      padding: 20px 24px;
    }
    .form-control, .form-select {
      border-radius: 10px;
      padding: 10px 14px;
      border: 1px solid var(--border-color);
    }
    .btn-main {
      background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      padding: 10px 20px;
    }
    .btn-main:hover {
      opacity: 0.9;
      color: white;
    }
    .table-container {
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: #ffffff;
      overflow: hidden;
    }
    .table th {
      background: #f8fafc;
      font-weight: 700;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-color);
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
  <div class="container">
    <a class="navbar-brand text-white" href="/hr/dashboard">
      <i class="fa-solid fa-paper-plane me-2"></i> HR Admin Portal
    </a>
    <div class="ms-auto">
      <a href="/hr/dashboard" class="btn btn-outline-light btn-sm rounded-pill px-3">Back to Dashboard</a>
    </div>
  </div>
</nav>

<header class="page-header">
  <div class="container">
    <p class="text-primary fw-bold mb-1" style="letter-spacing: 0.1em; font-size: 0.8rem;">PERFORMANCE MANAGEMENT</p>
    <h1 class="fw-bold mb-0">Appraisals & Performance Reviews</h1>
    <p class="text-muted mb-0">Launch corporate appraisal cycles, evaluate employee self-reviews, and submit manager feedback.</p>
  </div>
</header>

<div class="container pb-5">
  <div class="row g-4">
    <!-- Left Column: Launch Cycle -->
    <div class="col-lg-4">
      <div class="card">
        <div class="card-header">Start Appraisal Cycle</div>
        <div class="card-body p-4">
          <form action="/hr/appraisals/cycle/create" method="POST">
            <div class="mb-4">
              <label class="form-label fw-600">Cycle Name / Year</label>
              <input type="text" name="cycleName" class="form-control" placeholder="e.g. Annual Review 2026" required />
              <p class="text-muted small mt-2 mb-0">This will instantiate a blank self-appraisal form for all currently active employees.</p>
            </div>
            <button type="submit" class="btn btn-main w-100 py-3">Launch Appraisal Cycle</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Right Column: Active Employee Appraisals -->
    <div class="col-lg-8">
      <div class="table-container">
        <table class="table mb-0 align-middle">
          <thead>
            <tr>
              <th class="p-3">Employee</th>
              <th class="p-3 text-center">Cycle</th>
              <th class="p-3 text-center">Status</th>
              <th class="p-3 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (appraisals && appraisals.length > 0) { %>
              <% appraisals.forEach(app => { 
                if (app.employeeId) { %>
                  <tr>
                    <td class="p-3">
                      <div class="fw-bold"><%= app.employeeId.firstName %> <%= app.employeeId.lastName %></div>
                      <div class="text-muted small" style="font-size: 11px;"><%= app.employeeId.employeeCode %> • <%= app.employeeId.department %></div>
                    </td>
                    <td class="p-3 text-center text-secondary small"><%= app.cycleName %></td>
                    <td class="p-3 text-center">
                      <span class="badge <%= app.status === 'Completed' ? 'bg-success bg-opacity-10 text-success' : (app.status === 'Manager-Review' ? 'bg-warning bg-opacity-10 text-warning' : 'bg-secondary bg-opacity-10 text-secondary') %>">
                        <%= app.status %>
                      </span>
                    </td>
                    <td class="p-3 text-end">
                      <% if (app.status === 'Self-Appraisal') { %>
                        <span class="text-muted small">Awaiting Self-Review</span>
                      <% } else if (app.status === 'Manager-Review') { %>
                        <!-- Trigger Modal for Manager review -->
                        <button type="button" class="btn btn-sm btn-main rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#reviewModal-<%= app._id %>">
                          Review
                        </button>

                        <!-- Review Modal -->
                        <div class="modal fade text-start" id="reviewModal-<%= app._id %>" tabindex="-1">
                          <div class="modal-dialog">
                            <div class="modal-content">
                              <form action="/hr/appraisals/review/<%= app._id %>" method="POST">
                                <div class="modal-header">
                                  <h5 class="modal-title fw-bold">Performance Review: <%= app.employeeId.firstName %></h5>
                                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                  <div class="mb-3 bg-light p-3 rounded-3">
                                    <strong class="text-dark small d-block">Employee Self-Evaluation Comments:</strong>
                                    <p class="text-secondary small mb-2 mt-1">"<%= app.selfComments %>"</p>
                                    <strong class="text-dark small">Employee Self-Rating:</strong>
                                    <span class="badge bg-primary text-white ms-2"><%= app.selfRating %> / 5 Stars</span>
                                  </div>
                                  <div class="mb-3">
                                    <label class="form-label fw-bold">Manager Rating (1 to 5 Stars)</label>
                                    <select name="managerRating" class="form-select" required>
                                      <option value="">Choose rating...</option>
                                      <option value="5">5 - Outstanding</option>
                                      <option value="4">4 - Exceeds Expectations</option>
                                      <option value="3">3 - Meets Expectations</option>
                                      <option value="2">2 - Needs Improvement</option>
                                      <option value="1">1 - Unsatisfactory</option>
                                    </select>
                                  </div>
                                  <div class="mb-3">
                                    <label class="form-label fw-bold">Manager Comments & Feedback</label>
                                    <textarea name="managerComments" class="form-control" rows="4" placeholder="Detail your performance review comments..." required></textarea>
                                  </div>
                                </div>
                                <div class="modal-footer">
                                  <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                  <button type="submit" class="btn btn-primary fw-bold">Complete Appraisal</button>
                                </div>
                              </form>
                            </div>
                          </div>
                        </div>

                      <% } else if (app.status === 'Completed') { %>
                        <span class="badge bg-light text-dark border">
                          Self: <%= app.selfRating %>★ | Mgr: <%= app.managerRating %>★
                        </span>
                      <% } %>
                    </td>
                  </tr>
                <% } 
              }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="p-5 text-center text-muted">No appraisals run for this company yet. Start a new appraisal cycle on the left.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
