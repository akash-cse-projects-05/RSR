<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Roster Scheduler | HRMS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --rsr-blue: #2563eb;
      --rsr-bg: #f8fafc;
      --rsr-light: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: rgba(15, 23, 42, 0.08);
      --hrms-blue-dark: #050c1e;
    }
    body {
      background-color: var(--rsr-bg);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text-main);
    }
    .navbar {
      background: var(--hrms-blue-dark) !important;
      padding: 0.8rem 0;
    }
    .navbar-brand {
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .page-header {
      padding: 40px 0;
      background: #ffffff;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 30px;
    }
    .card {
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.02);
    }
    .card-header {
      font-weight: 700;
      background: transparent;
      border-bottom: 1px solid var(--border-color);
      padding: 20px 24px;
    }
    .form-control, .form-select {
      border-radius: 10px;
      padding: 10px 14px;
      border: 1px solid var(--border-color);
    }
    .btn-main {
      background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      padding: 10px 20px;
    }
    .btn-main:hover {
      opacity: 0.9;
      color: white;
    }
    .table-container {
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: #ffffff;
      overflow: hidden;
    }
    .table th {
      background: #f8fafc;
      font-weight: 700;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-color);
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
  <div class="container">
    <a class="navbar-brand text-white" href="/hr/dashboard">
      <i class="fa-solid fa-paper-plane me-2"></i> HR Admin Portal
    </a>
    <div class="ms-auto">
      <a href="/hr/dashboard" class="btn btn-outline-light btn-sm rounded-pill px-3">Back to Dashboard</a>
    </div>
  </div>
</nav>

<header class="page-header">
  <div class="container">
    <p class="text-primary fw-bold mb-1" style="letter-spacing: 0.1em; font-size: 0.8rem;">WORKFORCE ADMINISTRATION</p>
    <h1 class="fw-bold mb-0">Roster Calendar Allocation</h1>
    <p class="text-muted mb-0">Schedule active shifts for employees and assign rotational duties.</p>
  </div>
</header>

<div class="container pb-5">
  <div class="row g-4">
    <!-- Left Column: Allocate Shift Form -->
    <div class="col-lg-4">
      <div class="card">
        <div class="card-header">Assign Shift Roster</div>
        <div class="card-body p-4">
          <form action="/hr/roster/assign" method="POST">
            <div class="mb-3">
              <label class="form-label fw-600">Employee</label>
              <select name="employeeId" class="form-select" required>
                <option value="">Select Employee</option>
                <% employees.forEach(e => { %>
                  <option value="<%= e._id %>"><%= e.firstName %> <%= e.lastName %> (<%= e.employeeCode %>)</option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-600">Active Shift Profile</label>
              <select name="shiftId" class="form-select" required>
                <option value="">Select Shift</option>
                <% shifts.forEach(s => { %>
                  <option value="<%= s._id %>"><%= s.name %> (<%= s.startTime %> - <%= s.endTime %>)</option>
                <% }) %>
              </select>
            </div>
            <div class="row mb-4">
              <div class="col-6">
                <label class="form-label fw-600">Start Date</label>
                <input type="date" name="startDate" class="form-control" required />
              </div>
              <div class="col-6">
                <label class="form-label fw-600">End Date</label>
                <input type="date" name="endDate" class="form-control" required />
              </div>
            </div>
            <button type="submit" class="btn btn-main w-100 py-3">Assign Shift Roster</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Right Column: Roster Overview Grid -->
    <div class="col-lg-8">
      <div class="table-container">
        <table class="table mb-0 align-middle">
          <thead>
            <tr>
              <th class="p-3">Employee</th>
              <th class="p-3 text-center">Assigned Shift</th>
              <th class="p-3 text-center">Date Range</th>
              <th class="p-3 text-center">Shift Hours</th>
            </tr>
          </thead>
          <tbody>
            <% if (rosters && rosters.length > 0) { %>
              <% rosters.forEach(r => { 
                const emp = employees.find(e => e._id.toString() === r.employeeId.toString());
                if (emp) { %>
                  <tr>
                    <td class="p-3">
                      <div class="fw-bold"><%= emp.firstName %> <%= emp.lastName %></div>
                      <div class="text-muted small" style="font-size: 11px;"><%= emp.employeeCode %> • <%= emp.department %></div>
                    </td>
                    <td class="p-3 text-center">
                      <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 fw-bold">
                        <%= r.shiftId ? r.shiftId.name : 'Custom Shift' %>
                      </span>
                    </td>
                    <td class="p-3 text-center text-muted">
                      <%= new Date(r.startDate).toLocaleDateString() %> - <%= new Date(r.endDate).toLocaleDateString() %>
                    </td>
                    <td class="p-3 text-center">
                      <span class="badge bg-light text-dark border">
                        <%= r.shiftId ? r.shiftId.startTime : '09:00' %> - <%= r.shiftId ? r.shiftId.endTime : '17:00' %>
                      </span>
                    </td>
                  </tr>
                <% } 
              }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="p-5 text-center text-muted">No rosters assigned for this period. Use the form on the left to schedule shifts.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
