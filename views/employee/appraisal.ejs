<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Appraisals | HRMS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --rsr-blue: #2563eb;
      --rsr-bg: #f8fafc;
      --rsr-light: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: rgba(15, 23, 42, 0.08);
      --hrms-blue-dark: #050c1e;
    }
    body {
      background-color: var(--rsr-bg);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text-main);
    }
    .navbar {
      background: var(--hrms-blue-dark) !important;
      padding: 0.8rem 0;
    }
    .navbar-brand {
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .page-header {
      padding: 40px 0;
      background: #ffffff;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 30px;
    }
    .card {
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.02);
      overflow: hidden;
    }
    .card-header {
      font-weight: 700;
      background: transparent;
      border-bottom: 1px solid var(--border-color);
      padding: 20px 24px;
    }
    .form-control, .form-select {
      border-radius: 10px;
      padding: 10px 14px;
      border: 1px solid var(--border-color);
    }
    .btn-main {
      background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      padding: 10px 20px;
    }
    .btn-main:hover {
      opacity: 0.9;
      color: white;
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
  <div class="container">
    <a class="navbar-brand text-white" href="/dashboard">
      <i class="fa-solid fa-paper-plane me-2"></i> Employee Portal
    </a>
    <div class="ms-auto">
      <a href="/dashboard" class="btn btn-outline-light btn-sm rounded-pill px-3">Back to Dashboard</a>
    </div>
  </div>
</nav>

<header class="page-header">
  <div class="container">
    <p class="text-primary fw-bold mb-1" style="letter-spacing: 0.1em; font-size: 0.8rem;">PERFORMANCE MANAGEMENT</p>
    <h1 class="fw-bold mb-0">My Performance Reviews</h1>
    <p class="text-muted mb-0">Submit self-evaluations and track your annual performance appraisal outcome.</p>
  </div>
</header>

<div class="container pb-5">
  <div class="row g-4">
    <% if (appraisals && appraisals.length > 0) { %>
      <% appraisals.forEach(app => { %>
        <div class="col-lg-6 col-12">
          <div class="card">
            <div class="card-header bg-light d-flex align-items-center justify-content-between py-3">
              <span class="fw-bold text-dark"><%= app.cycleName %></span>
              <span class="badge <%= app.status === 'Completed' ? 'bg-success bg-opacity-10 text-success' : 'bg-warning bg-opacity-10 text-warning' %>">
                <%= app.status %>
              </span>
            </div>
            
            <div class="card-body p-4">
              <!-- Case A: Self-Appraisal Pending -->
              <% if (app.status === 'Self-Appraisal') { %>
                <form action="/performance/my-appraisals/submit/<%= app._id %>" method="POST">
                  <div class="mb-3">
                    <label class="form-label fw-bold">Self Rating (1 to 5 Stars)</label>
                    <select name="selfRating" class="form-select" required>
                      <option value="">Choose rating...</option>
                      <option value="5">5 - Outstanding</option>
                      <option value="4">4 - Exceeds Expectations</option>
                      <option value="3">3 - Meets Expectations</option>
                      <option value="2">2 - Needs Improvement</option>
                      <option value="1">1 - Unsatisfactory</option>
                    </select>
                  </div>
                  <div class="mb-4">
                    <label class="form-label fw-bold">Self Comments</label>
                    <textarea name="selfComments" class="form-control" rows="4" placeholder="Detail your accomplishments and contributions during this appraisal period..." required></textarea>
                  </div>
                  <button type="submit" class="btn btn-main w-100 py-3">Submit Self-Appraisal</button>
                </form>

              <!-- Case B: Under Manager Review -->
              <% } else if (app.status === 'Manager-Review') { %>
                <div class="mb-3">
                  <strong class="text-muted small">Your Self-Rating:</strong>
                  <div class="fw-bold text-primary"><%= app.selfRating %> / 5 Stars</div>
                </div>
                <div class="mb-3">
                  <strong class="text-muted small">Your Comments:</strong>
                  <p class="text-secondary small bg-light p-3 rounded-3 mt-1"><%= app.selfComments %></p>
                </div>
                <div class="alert alert-info text-center small mb-0 mt-4">
                  <i class="fa-solid fa-hourglass-half me-2"></i> Under manager review. Ratings will unlock once finalized by HR/Management.
                </div>

              <!-- Case C: Appraisal Complete -->
              <% } else if (app.status === 'Completed') { %>
                <div class="row g-3">
                  <div class="col-6 border-end">
                    <strong class="text-muted small">Your Rating:</strong>
                    <div class="fw-bold text-primary fs-5"><%= app.selfRating %> / 5 Stars</div>
                  </div>
                  <div class="col-6 ps-3">
                    <strong class="text-muted small">Manager Rating:</strong>
                    <div class="fw-bold text-success fs-5"><%= app.managerRating %> / 5 Stars</div>
                  </div>
                </div>
                <div class="mt-3">
                  <strong class="text-muted small">Manager Feedback:</strong>
                  <p class="text-dark small bg-success bg-opacity-10 p-3 rounded-3 mt-1 fw-500"><%= app.managerComments || 'No manager comments entered.' %></p>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12">
        <div class="card p-5 text-center text-muted">
          <i class="fa-solid fa-sheet-plastic fa-3x mb-3 text-secondary"></i>
          <h5>No Appraisal Cycles Active</h5>
          <p class="mb-0">You do not have any pending performance appraisal reviews scheduled at this time.</p>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
