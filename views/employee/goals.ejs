<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My OKR Goals | HRMS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --rsr-blue: #2563eb;
      --rsr-bg: #f8fafc;
      --rsr-light: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: rgba(15, 23, 42, 0.08);
      --hrms-blue-dark: #050c1e;
    }
    body {
      background-color: var(--rsr-bg);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text-main);
    }
    .navbar {
      background: var(--hrms-blue-dark) !important;
      padding: 0.8rem 0;
    }
    .navbar-brand {
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .page-header {
      padding: 40px 0;
      background: #ffffff;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 30px;
    }
    .card {
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.02);
    }
    .card-header {
      font-weight: 700;
      background: transparent;
      border-bottom: 1px solid var(--border-color);
      padding: 20px 24px;
    }
    .form-control {
      border-radius: 10px;
      padding: 10px 14px;
      border: 1px solid var(--border-color);
    }
    .btn-main {
      background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      padding: 10px 20px;
    }
    .btn-main:hover {
      opacity: 0.9;
      color: white;
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
  <div class="container">
    <a class="navbar-brand text-white" href="/dashboard">
      <i class="fa-solid fa-paper-plane me-2"></i> Employee Portal
    </a>
    <div class="ms-auto">
      <a href="/dashboard" class="btn btn-outline-light btn-sm rounded-pill px-3">Back to Dashboard</a>
    </div>
  </div>
</nav>

<header class="page-header">
  <div class="container">
    <p class="text-primary fw-bold mb-1" style="letter-spacing: 0.1em; font-size: 0.8rem;">PERFORMANCE MANAGEMENT</p>
    <h1 class="fw-bold mb-0">My OKR Goals</h1>
    <p class="text-muted mb-0">Define objectives, list target milestones, and update your development progress.</p>
  </div>
</header>

<div class="container pb-5">
  <div class="row g-4">
    <!-- Left Column: Add Goal -->
    <div class="col-lg-4">
      <div class="card">
        <div class="card-header">Create OKR Goal</div>
        <div class="card-body p-4">
          <form action="/performance/my-goals/add" method="POST">
            <div class="mb-3">
              <label class="form-label fw-600">Objective Title</label>
              <input type="text" name="title" class="form-control" placeholder="e.g. Optimize API response times by 30%" required />
            </div>
            <div class="mb-3">
              <label class="form-label fw-600">Description</label>
              <textarea name="description" class="form-control" rows="3" placeholder="Explain the key objective..."></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label fw-600">Target Date</label>
              <input type="date" name="targetDate" class="form-control" required />
            </div>
            <div class="mb-4">
              <label class="form-label fw-600">Key Results (Optional)</label>
              <input type="text" name="keyResults" class="form-control mb-2" placeholder="Key Result 1" />
              <input type="text" name="keyResults" class="form-control mb-2" placeholder="Key Result 2" />
              <input type="text" name="keyResults" class="form-control" placeholder="Key Result 3" />
            </div>
            <button type="submit" class="btn btn-main w-100 py-3">Submit Goal</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Right Column: Goals Progress -->
    <div class="col-lg-8">
      <% if (goals && goals.length > 0) { %>
        <div class="row g-3">
          <% goals.forEach(goal => { %>
            <div class="col-12">
              <div class="card p-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <div>
                    <h5 class="fw-bold mb-1"><%= goal.title %></h5>
                    <p class="text-muted small mb-0">Target Date: <%= new Date(goal.targetDate).toLocaleDateString() %></p>
                  </div>
                  <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 fw-bold"><%= goal.status %></span>
                </div>
                
                <p class="text-secondary small mb-3"><%= goal.description %></p>

                <!-- Key Results List -->
                <% if (goal.keyResults && goal.keyResults.length > 0) { %>
                  <div class="mb-3 bg-light p-3 rounded-3">
                    <strong class="text-dark small d-block mb-2">Key Results Checklist:</strong>
                    <form action="/performance/my-goals/update-progress/<%= goal._id %>" method="POST">
                      <% goal.keyResults.forEach(kr => { %>
                        <div class="form-check mb-1">
                          <input class="form-check-input" type="checkbox" name="completedKrs" value="<%= kr._id %>" id="kr-<%= kr._id %>" <%= kr.completed ? 'checked' : '' %> onchange="this.form.submit()" />
                          <label class="form-check-label small <%= kr.completed ? 'text-decoration-line-through text-muted' : '' %>" for="kr-<%= kr._id %>">
                            <%= kr.text %>
                          </label>
                        </div>
                      <% }) %>
                      <input type="hidden" name="status" value="<%= goal.status %>" />
                    </form>
                  </div>
                <% } %>

                <!-- Progress Bar -->
                <div class="d-flex align-items-center justify-content-between">
                  <form action="/performance/my-goals/update-progress/<%= goal._id %>" method="POST" class="d-flex align-items-center w-100">
                    <label class="small text-muted me-3">Progress:</label>
                    <input type="range" name="progress" class="form-range me-3" style="max-width: 200px;" min="0" max="100" value="<%= goal.progress %>" onchange="this.form.submit()" />
                    <strong class="text-dark"><%= goal.progress %>%</strong>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="card p-5 text-center text-muted">
          <i class="fa-solid fa-bullseye fa-3x mb-3 text-secondary"></i>
          <h5>No OKR Goals Created</h5>
          <p class="mb-0">Create your first goal objective using the form on the left to start tracking performance.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
