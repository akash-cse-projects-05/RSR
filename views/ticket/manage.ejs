<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Helpdesk Tickets | HRMS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8fafc; font-family: 'Plus Jakarta Sans', sans-serif; color: #0f172a; }
    .page-header { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: white; padding: 35px 0; margin-bottom: 30px; }
    .card-ticket { background: white; border: 1px solid #e2e8f0; border-radius: 14px; padding: 20px; margin-bottom: 16px; }
  </style>
</head>
<body>
  <%- include('../partials/anti-cache') %>

  <div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
      <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-list-check me-2 text-info"></i>Ticket Resolution Hub</h3>
        <p class="text-slate-400 mb-0">Review, update, and resolve support requests assigned to your department</p>
      </div>
      <div>
        <a href="/ticket" class="btn btn-outline-light rounded-pill px-3 me-2"><i class="fa-solid fa-arrow-left me-1"></i>My Tickets</a>
        <a href="/dashboard" class="btn btn-light rounded-pill px-3"><i class="fa-solid fa-house me-1"></i>Dashboard</a>
      </div>
    </div>
  </div>

  <div class="container pb-5">
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4"><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold mb-0">Active Department Support Tickets (<%= tickets.length %>)</h5>
    </div>

    <% if (tickets.length === 0) { %>
      <div class="text-center py-5 bg-white rounded-4 border">
        <i class="fa-solid fa-check-double text-success fa-3x mb-3"></i>
        <h5 class="fw-semibold text-muted">All support tickets resolved</h5>
        <p class="text-muted small">No pending support requests in queue for your department.</p>
      </div>
    <% } else { %>
      <% tickets.forEach(t => { %>
        <div class="card-ticket shadow-sm">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <span class="badge bg-primary rounded-pill me-2"><%= t.targetDepartment %> Dept</span>
              <span class="badge bg-secondary rounded-pill me-2">Priority: <%= t.priority %></span>
              <span class="badge bg-dark rounded-pill"><%= t.status %></span>
            </div>
            <small class="text-muted"><i class="fa-regular fa-user me-1"></i><%= t.employeeName %> | <%= new Date(t.createdAt).toLocaleDateString() %></small>
          </div>
          <h5 class="fw-bold text-dark mb-1"><%= t.subject %></h5>
          <p class="text-slate-600 mb-3"><%= t.description %></p>

          <form action="/ticket/<%= t._id %>/update" method="POST" class="bg-slate-50 p-3 rounded-3 border">
            <div class="row g-2 align-items-center">
              <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Update Status</label>
                <select name="status" class="form-select form-select-sm">
                  <option value="Open" <%= t.status === 'Open' ? 'selected' : '' %>>Open</option>
                  <option value="In Progress" <%= t.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                  <option value="Resolved" <%= t.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                  <option value="Closed" <%= t.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                </select>
              </div>
              <div class="col-md-5">
                <label class="form-label small fw-semibold mb-1">Resolution Notes</label>
                <input type="text" name="resolutionNotes" class="form-control form-control-sm" value="<%= t.resolutionNotes || '' %>" placeholder="Enter resolution explanation...">
              </div>
              <div class="col-md-4 text-end mt-4">
                <button type="submit" class="btn btn-success btn-sm rounded-pill px-4"><i class="fa-solid fa-save me-1"></i>Save Updates</button>
              </div>
            </div>
          </form>
        </div>
      <% }) %>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
