<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Helpdesk Support Tickets | HRMS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8fafc; font-family: 'Plus Jakarta Sans', sans-serif; color: #0f172a; }
    .page-header { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: white; padding: 40px 0; border-radius: 0 0 24px 24px; margin-bottom: 30px; }
    .ticket-card { background: white; border: 1px solid #e2e8f0; border-radius: 16px; transition: all 0.2s ease; margin-bottom: 16px; }
    .ticket-card:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
    .badge-priority-Urgent { background: #ef4444; color: white; }
    .badge-priority-High { background: #f97316; color: white; }
    .badge-priority-Medium { background: #3b82f6; color: white; }
    .badge-priority-Low { background: #64748b; color: white; }
    .badge-status-Open { background: #dbeafe; color: #1e40af; }
    .badge-status-In\ Progress { background: #fef3c7; color: #92400e; }
    .badge-status-Resolved { background: #dcfce7; color: #166534; }
  </style>
</head>
<body>
  <%- include('../partials/anti-cache') %>

  <div class="page-header text-center">
    <div class="container">
      <h2 class="fw-bold mb-1"><i class="fa-solid fa-headset me-2 text-info"></i>Helpdesk & Support Tickets</h2>
      <p class="text-slate-300 mb-3">Raise technical, HR, payroll, or facility requests to your management team</p>
      <button class="btn btn-primary btn-lg rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#newTicketModal">
        <i class="fa-solid fa-plus-circle me-2"></i>Raise New Support Ticket
      </button>
      <a href="/dashboard" class="btn btn-outline-light btn-lg rounded-pill px-4 ms-2">
        <i class="fa-solid fa-house me-2"></i>Dashboard
      </a>
    </div>
  </div>

  <div class="container pb-5">
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4"><i class="fa-solid fa-circle-check me-2"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4"><i class="fa-solid fa-circle-exclamation me-2"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h5 class="fw-bold mb-0">My Submitted Tickets (<%= tickets.length %>)</h5>
      <a href="/ticket/manage" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="fa-solid fa-sliders me-1"></i>Manage Department Tickets</a>
    </div>

    <% if (tickets.length === 0) { %>
      <div class="text-center py-5 bg-white rounded-4 border">
        <i class="fa-solid fa-ticket-simple text-slate-300 fa-4x mb-3"></i>
        <h5 class="fw-semibold text-muted">No support tickets submitted yet</h5>
        <p class="text-muted small">Need assistance with hardware, leave calculations, or workspace issues? Click above to raise a ticket.</p>
      </div>
    <% } else { %>
      <div class="row">
        <% tickets.forEach(t => { %>
          <div class="col-12">
            <div class="ticket-card p-4">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <span class="badge badge-priority-<%= t.priority %> rounded-pill px-3 py-1 me-2"><%= t.priority %> Priority</span>
                  <span class="badge bg-slate-100 text-slate-700 border rounded-pill px-3 py-1 me-2"><i class="fa-solid fa-building me-1"></i><%= t.targetDepartment %> Dept</span>
                  <span class="badge badge-status-<%= t.status %> rounded-pill px-3 py-1"><%= t.status %></span>
                </div>
                <small class="text-muted"><i class="fa-regular fa-clock me-1"></i><%= new Date(t.createdAt).toLocaleDateString() %></small>
              </div>
              <h5 class="fw-bold text-dark mt-2 mb-1"><%= t.subject %></h5>
              <p class="text-slate-600 mb-3"><%= t.description %></p>

              <% if (t.resolutionNotes) { %>
                <div class="p-3 bg-success-subtle border border-success-subtle rounded-3 mb-3">
                  <small class="fw-bold text-success d-block mb-1"><i class="fa-solid fa-circle-check me-1"></i>Resolution Details:</small>
                  <small class="text-dark"><%= t.resolutionNotes %></small>
                </div>
              <% } %>

              <% if (t.comments && t.comments.length > 0) { %>
                <div class="bg-slate-50 p-3 rounded-3 border">
                  <small class="fw-semibold text-muted mb-2 d-block">Discussion History (<%= t.comments.length %>)</small>
                  <% t.comments.forEach(c => { %>
                    <div class="border-bottom py-1">
                      <strong class="small text-primary"><%= c.postedBy %> (<%= c.role %>):</strong>
                      <span class="small text-slate-700"><%= c.text %></span>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Create Ticket Modal -->
  <div class="modal fade" id="newTicketModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0 shadow">
        <form action="/ticket/create" method="POST">
          <div class="modal-header border-bottom-0 pb-0">
            <h5 class="modal-title fw-bold"><i class="fa-solid fa-ticket me-2 text-primary"></i>Raise Support Ticket</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label fw-semibold">Target Department</label>
              <select name="targetDepartment" class="form-select" required>
                <option value="IT">IT Support (Hardware / Software)</option>
                <option value="HR">HR & Payroll</option>
                <option value="Finance">Finance & Reimbursements</option>
                <option value="Admin">Admin & Facilities</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Category</label>
              <input type="text" name="category" class="form-control" placeholder="e.g. Laptop Repair, Salary Slip Discrepancy" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Priority Level</label>
              <select name="priority" class="form-select">
                <option value="Low">Low</option>
                <option value="Medium" selected>Medium</option>
                <option value="High">High</option>
                <option value="Urgent">Urgent</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Subject / Title</label>
              <input type="text" name="subject" class="form-control" placeholder="Short description of the issue" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Detailed Description</label>
              <textarea name="description" class="form-control" rows="4" placeholder="Provide complete details..." required></textarea>
            </div>
          </div>
          <div class="modal-footer border-top-0 pt-0">
            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="fa-solid fa-paper-plane me-1"></i>Submit Ticket</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
