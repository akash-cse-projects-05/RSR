<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Training & Learning Portal | HRMS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8fafc; font-family: 'Plus Jakarta Sans', sans-serif; color: #0f172a; }
    .page-header { background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); color: white; padding: 40px 0; border-radius: 0 0 24px 24px; margin-bottom: 35px; }
    .course-card { background: white; border: 1px solid #e2e8f0; border-radius: 16px; transition: all 0.2s ease; height: 100%; display: flex; flex-direction: column; }
    .course-card:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(0,0,0,0.08); }
    .course-body { padding: 24px; flex-grow: 1; }
    .course-footer { padding: 16px 24px; border-top: 1px solid #f1f5f9; background: #f8fafc; border-radius: 0 0 16px 16px; }
  </style>
</head>
<body>
  <%- include('../partials/anti-cache') %>

  <div class="page-header text-center">
    <div class="container">
      <h2 class="fw-bold mb-1"><i class="fa-solid fa-graduation-cap me-2 text-warning"></i>Employee Learning & Training Portal</h2>
      <p class="text-sky-100 mb-3">Access compliance courses, skill development guides, and mandatory training modules</p>
      <a href="/training/manage" class="btn btn-light rounded-pill px-4 me-2"><i class="fa-solid fa-gear me-1"></i>HR Course Manager</a>
      <a href="/dashboard" class="btn btn-outline-light rounded-pill px-4"><i class="fa-solid fa-house me-1"></i>Dashboard</a>
    </div>
  </div>

  <div class="container pb-5">
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4"><i class="fa-solid fa-circle-check me-2"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4"><i class="fa-solid fa-circle-exclamation me-2"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <h5 class="fw-bold mb-4">Assigned Learning Courses & Modules (<%= trainings.length %>)</h5>

    <% if (trainings.length === 0) { %>
      <div class="text-center py-5 bg-white rounded-4 border">
        <i class="fa-solid fa-book-open text-slate-300 fa-4x mb-3"></i>
        <h5 class="fw-semibold text-muted">No training modules assigned yet</h5>
        <p class="text-muted small">Check back later for company compliance or department skill training updates.</p>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% trainings.forEach(t => { %>
          <div class="col-md-6 col-lg-4">
            <div class="course-card">
              <div class="course-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1"><%= t.category %></span>
                  <% if (t.myStatus === 'Completed') { %>
                    <span class="badge bg-success rounded-pill px-3 py-1"><i class="fa-solid fa-check me-1"></i>Completed</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="fa-regular fa-clock me-1"></i>Pending</span>
                  <% } %>
                </div>
                <h5 class="fw-bold text-dark mb-2"><%= t.title %></h5>
                <p class="text-slate-600 small mb-3"><%= t.description %></p>
                <div class="d-flex align-items-center text-muted small">
                  <i class="fa-solid fa-clock me-1 text-slate-400"></i><%= t.durationMinutes %> Minutes
                  <span class="mx-2">•</span>
                  <i class="fa-solid fa-layer-group me-1 text-slate-400"></i><%= t.contentType %>
                </div>
              </div>
              <div class="course-footer d-flex justify-content-between align-items-center">
                <a href="<%= t.contentUrl %>" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                  <i class="fa-solid fa-up-right-from-square me-1"></i>Open Module
                </a>
                <% if (t.myStatus !== 'Completed') { %>
                  <form action="/training/<%= t._id %>/complete" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">
                      <i class="fa-solid fa-check-circle me-1"></i>Mark Done
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
